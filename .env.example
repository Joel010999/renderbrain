# RenderBrain - Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

APP_NAME=RenderBrain
ENVIRONMENT=development
DEBUG=False

# ---------------------------------------------------------------------------
# PostgreSQL — credenciales del contenedor Docker
# Estas variables son consumidas por docker-compose.yml Y por DATABASE_URL
# ---------------------------------------------------------------------------
POSTGRES_USER=renderbrain
POSTGRES_PASSWORD=change_me_in_dot_env
POSTGRES_DB=renderbrain_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# SQLAlchemy + asyncpg — URL de conexión asíncrona
# Construir a mano usando los valores anteriores (dotenv no expande variables)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://renderbrain:change_me_in_dot_env@localhost:5432/renderbrain_db

# ---------------------------------------------------------------------------
# Redis — contenedor Docker
# docker-compose.yml publica REDIS_PORT en localhost
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Apify — proveedor externo de scraping (S2.1)
# SEGURIDAD: APIFY_API_TOKEN nunca debe hardcodearse ni aparecer en logs.
#   Pydantic lo almacena como SecretStr; get_secret_value() es el único
#   método para acceder al valor y solo se llama dentro del adaptador.
# APIFY_INSTAGRAM_ACTOR_ID: se puede sobreescribir para pruebas o cambiar
#   de actor sin tocar el código fuente.
# ---------------------------------------------------------------------------
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper

# ---------------------------------------------------------------------------
# OpenAI — proveedor de LLM (S3.2)
# OPENAI_API_KEY nunca debe hardcodearse ni imprimirse.
# OPENAI_MODEL: modelo base a usar (ej: gpt-4o-mini)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Dashboard Auth (S6.3)
# Credenciales mínimas para proteger el entorno web.
# RENDERBRAIN_ADMIN_PASSWORD no tiene default por seguridad y DEBE setearse.
# ---------------------------------------------------------------------------
RENDERBRAIN_ADMIN_USERNAME=admin
RENDERBRAIN_ADMIN_PASSWORD=change_me_in_dot_env
